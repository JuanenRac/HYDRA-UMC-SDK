{
  "source_version": "1",
  "group": "watch",
  "kind": "inventory",
  "routes": [
    {
      "method": "get",
      "path": "/api/watch/system-status",
      "summary": "GET /api/watch/system-status",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "responses": {
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/watch/release-notice",
      "summary": "POST /api/watch/release-notice",
      "description": "Requires a signed-in account (bearer token). A phone says whether it tells its watch about a newer release of the app. Information only: the server changes nothing on the phone or the watch.",
      "access": "user",
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "device_id",
                "platform",
                "notifies_watch"
              ],
              "properties": {
                "device_id": {
                  "type": "string"
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "android",
                    "ios"
                  ]
                },
                "notifies_watch": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success. The body is documented in docs/REMOTE_API.md.",
          "shape": "WatchReleaseNoticeSaved"
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "get",
      "path": "/api/admin/watch/release-notice",
      "summary": "GET /api/admin/watch/release-notice",
      "description": "Requires a signed-in account with the admin role. What the phones said about telling their watch of a newer release.",
      "access": "admin",
      "responses": {
        "200": {
          "description": "Success. The body is documented in docs/REMOTE_API.md.",
          "shape": "WatchReleaseNoticeList"
        }
      }
    }
  ]
}
