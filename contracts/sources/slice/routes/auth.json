{
  "tag": "auth",
  "operations": [
    {
      "path": "/api/login",
      "method": "post",
      "operation": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "summary": "Authenticate with a local username/password and obtain a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Real JWT issued - pass it as `Authorization: Bearer <token>` on every route below tagged with bearerAuth.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "username/password missing or not strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Real invalid-credentials rejection - same message for an unknown username and a wrong password, on purpose (never confirms which one was wrong). When the account has the second step on and no valid `totp` was sent, the body also carries `totpRequired: true`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed sign-in attempts from this address; wait for the window to pass.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    {
      "path": "/api/refresh",
      "method": "post",
      "operation": {
        "tags": [
          "auth"
        ],
        "operationId": "refreshToken",
        "summary": "Exchange a refresh token for a new access token",
        "description": "No bearer token needed: the refresh token is the credential. It is single use; the response carries its replacement.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new access token and a new refresh token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "refreshToken missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The refresh token is unknown, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many refresh attempts from this address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedResponse"
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "/api/logout",
      "method": "post",
      "operation": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "summary": "Revoke a refresh token",
        "description": "Always answers success: an unknown or already used token is not an error.",
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    }
  ]
}
