{
  "tag": "safety",
  "operations": [
    {
      "path": "/api/robot/{id}/jog-arm",
      "method": "post",
      "operation": {
        "tags": [
          "safety"
        ],
        "operationId": "armRobotJog",
        "summary": "Arm or disarm the jog of a robot",
        "description": "The arming belongs to the account and controller that made it, lasts at most `jog.armTtlMs` and is only demanded while `jog.armRequired` is on. `stop`, the global stop and `release` clear it.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "A robot own numeric id."
          },
          {
            "$ref": "#/components/parameters/ControllerIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JogArmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Armed or disarmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JogArmResponse"
                }
              }
            }
          },
          "400": {
            "description": "`armed` is not a boolean, or `invalid-controller-id`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No robot with this id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Another account or controller holds the claim.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationConflict"
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "/api/safety-limits",
      "method": "get",
      "operation": {
        "tags": [
          "safety"
        ],
        "operationId": "getSafetyLimits",
        "summary": "The safety limits every client is held to",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "robotId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Adds the limits of that robot model and its jog arming."
          }
        ],
        "responses": {
          "200": {
            "description": "The limits in force.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyLimitsView"
                }
              }
            }
          },
          "400": {
            "description": "`robotId` is not an integer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No robot with this id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "/api/admin/safety-limits",
      "method": "put",
      "operation": {
        "tags": [
          "safety"
        ],
        "operationId": "updateSafetyLimits",
        "summary": "Change the safety limits (administrator)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SafetyLimitsPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; the answer carries the limits now in force.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafetyLimitsUpdateResult"
                }
              }
            }
          },
          "400": {
            "description": "An unknown key, a wrong type or a value beyond the hard ceilings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Administrator role required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "/api/audit",
      "method": "get",
      "operation": {
        "tags": [
          "safety"
        ],
        "operationId": "getAudit",
        "summary": "The audit record (administrators)",
        "description": "The newest entries, oldest first. `format=jsonl` downloads the lines as stored.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "afterSeq",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "robotId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "verify",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "true"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "jsonl"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditView"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`audit-unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    {
      "path": "/api/stop-all/release",
      "method": "post",
      "operation": {
        "tags": [
          "safety"
        ],
        "operationId": "releaseGlobalStop",
        "summary": "Say that the global stop is over (administrators)",
        "description": "Publishes the retained `READY` on the MQTT bridge when announcing the global stop is configured (`announced: false` otherwise or when the broker is not connected). It moves no robot and is written to the audit record. No body.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The release was recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalStopReleased"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The account is not an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  ]
}
