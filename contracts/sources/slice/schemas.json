{
  "ErrorResponse": {
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "string"
      },
      "code": {
        "type": "string",
        "description": "Stable refusal codes: `other-account`, `other-controller`, `controller-id-required`, `invalid-controller-id`, `jog-not-armed`, `revision-mismatch`, `table-invalid`, `table-out-of-limit`, `table-missing`. A client must keep an unknown code as a plain error."
      },
      "totpRequired": {
        "const": true,
        "description": "Present on a sign-in answered with 401 or 429 when the account has the second step on: the sign-in must be repeated with `totp`."
      }
    },
    "additionalProperties": true
  },
  "SuccessResponse": {
    "type": "object",
    "required": [
      "success"
    ],
    "properties": {
      "success": {
        "const": true
      }
    },
    "additionalProperties": true
  },
  "ServerDiscovery": {
    "type": "object",
    "description": "Mirrors contracts/json-schema/v1/server-discovery.schema.json field-for-field - restated here natively rather than $ref'd across schema drafts, since that file's own $id/$schema target JSON Schema 2020-12 directly rather than through OpenAPI's Schema Object.",
    "required": [
      "schema_version",
      "product",
      "remoteApiVersion",
      "appVersion",
      "hostname",
      "controllerCount",
      "robotCount",
      "uptimeSeconds"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "product": {
        "type": "string",
        "minLength": 1
      },
      "remoteApiVersion": {
        "type": "integer",
        "minimum": 1
      },
      "appVersion": {
        "type": "string",
        "minLength": 1
      },
      "hostname": {
        "type": "string",
        "minLength": 1
      },
      "controllerCount": {
        "type": "integer",
        "minimum": 0
      },
      "robotCount": {
        "type": "integer",
        "minimum": 0
      },
      "uptimeSeconds": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": true
  },
  "LoginRequest": {
    "type": "object",
    "required": [
      "username",
      "password"
    ],
    "properties": {
      "username": {
        "type": "string"
      },
      "password": {
        "type": "string"
      },
      "totp": {
        "type": "string",
        "description": "The code of the second step (a 6-digit code from an authenticator app or an unused recovery code). Only for an account that turned the second step on; sending it for one that did not is harmless."
      }
    },
    "additionalProperties": false
  },
  "LoginResponse": {
    "type": "object",
    "required": [
      "success",
      "token",
      "role"
    ],
    "properties": {
      "success": {
        "const": true
      },
      "token": {
        "type": "string",
        "description": "A signed JWT (see JWT_EXPIRES_IN for this server's configured lifetime, default 30d)."
      },
      "role": {
        "type": "string",
        "description": "e.g. \"admin\" or \"operator\" - see docs/CONTRACTS.md's account-management notes."
      },
      "refreshToken": {
        "type": "string",
        "description": "An opaque, single-use refresh token (90 days by default). Exchange it at POST /api/refresh for a new access token and a new refresh token."
      }
    },
    "additionalProperties": true
  },
  "RobotRosterEntry": {
    "type": "object",
    "description": "Only the roster-level fields real typed clients (e.g. HYDRA-UMC-TOOL-CLI's own robots.go) actually consume are modeled - a real robot object carries many more live-state fields (pos, joints, playbackState, valves, pumps, camera, xyTable, ...) not exhaustively typed here, matching this contract's own additive philosophy.",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "description": "A real robot's own numeric id - distinct from a controller's own id, which may be a string."
      },
      "name": {
        "type": "string"
      },
      "online": {
        "type": "boolean"
      },
      "model": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "combinedWith": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "description": "Sibling robot ids that share this robot's non-trajectory commands (see the command plane's own affectedIds rule)."
      }
    },
    "additionalProperties": true
  },
  "ControllerRosterEntry": {
    "type": "object",
    "required": [
      "id",
      "name",
      "robots"
    ],
    "properties": {
      "id": {
        "description": "A real controller's own id - may be a string (e.g. \"localhost\" for the default local controller) even though a robot's own id is always numeric; a real, confirmed API inconsistency, not a typo."
      },
      "name": {
        "type": "string"
      },
      "ip": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "robots": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RobotRosterEntry"
        }
      }
    },
    "additionalProperties": true
  },
  "SettingsDocument": {
    "type": "object",
    "description": "The real, full settings document persisted to data/settings.json. `settings` is deliberately left opaque (type: object only) - it carries UI layout, integrations, gamepad mapping, and other fields the server itself treats as an untyped blob it never validates; only `controllers` is modeled to roster depth, since that is the real, stable surface existing typed clients already depend on.",
    "properties": {
      "settings": {
        "type": "object",
        "additionalProperties": true
      },
      "controllers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ControllerRosterEntry"
        }
      }
    },
    "additionalProperties": true
  },
  "RobotCommandResult": {
    "type": "object",
    "required": [
      "success",
      "affectedCount"
    ],
    "properties": {
      "success": {
        "const": true
      },
      "affectedCount": {
        "type": "integer",
        "minimum": 0,
        "description": "How many robots this one command actually touched - more than 1 only for a non-trajectory command on a combined pair (see combinedWith)."
      },
      "warnings": {
        "type": "array",
        "description": "Present when part of a recognised command was discarded (for example a speed outside 10-500, a jog with an unknown axis, a valve index outside 0-7).",
        "items": {
          "type": "object",
          "required": [
            "robotId",
            "field",
            "message"
          ],
          "properties": {
            "robotId": {
              "type": "integer"
            },
            "field": {
              "type": "string"
            },
            "requested": {},
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "revision": {
        "type": "string",
        "description": "The new revision of the robot the command was sent to (also the `ETag`)."
      },
      "applied": {
        "type": "object",
        "description": "Only after a `table` move: the position the table ended in.",
        "required": [
          "robotId",
          "x",
          "y"
        ],
        "properties": {
          "robotId": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rz": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "CommandStop": {
    "type": "object",
    "description": "Stops playback now (also stops this robot's own server-side playback timer) and clears isPlaying/activeStep/isPaused/isFinished.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "stop"
      }
    }
  },
  "CommandPlay": {
    "type": "object",
    "description": "Starts playback from step 0 (also starts this robot's own server-side playback timer).",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "play"
      }
    }
  },
  "CommandPause": {
    "type": "object",
    "description": "Toggles pause by default; `params.paused` sets an explicit desired state instead, so a combined pair can never end up with one paused member and one not.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "pause"
      },
      "params": {
        "type": "object",
        "properties": {
          "paused": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "CommandJog": {
    "type": "object",
    "description": "Relative (or, with absolute:true, absolute) single-axis motion. target:\"xytable\" only honors axis x/y and requires the robot to have a configured XY table; target:\"robot\" (default) applies to any of x/y/z/a/b/c and accepts an optional client-computed joints override (validated as 6 finite numbers, else the server falls back to its own generic IK).",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "jog"
      },
      "params": {
        "type": "object",
        "required": [
          "axis",
          "amount"
        ],
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "x",
              "y",
              "z",
              "a",
              "b",
              "c"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "target": {
            "type": "string",
            "enum": [
              "robot",
              "xytable"
            ],
            "default": "robot"
          },
          "absolute": {
            "type": "boolean",
            "default": false,
            "description": "Set the axis to amount instead of adding amount to it."
          },
          "joints": {
            "type": "object",
            "description": "Optional client-computed joint override, only honored for target:\"robot\".",
            "properties": {
              "j1": {
                "type": "number"
              },
              "j2": {
                "type": "number"
              },
              "j3": {
                "type": "number"
              },
              "j4": {
                "type": "number"
              },
              "j5": {
                "type": "number"
              },
              "j6": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "CommandReset": {
    "type": "object",
    "description": "target:\"robot\" (default) zeroes pos/joints to home (tx/ty/trz preserved); target:\"xytable\" zeroes only the XY table's own pos and pos.tx/ty, leaving the arm's own pose untouched.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "reset"
      },
      "params": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "robot",
              "xytable"
            ],
            "default": "robot"
          },
          "joints": {
            "type": "object",
            "description": "Optional client-supplied home pose (e.g. a per-model homePoseFor(robot.model)); falls back to the server's own generic IK if omitted/invalid.",
            "properties": {
              "j1": {
                "type": "number"
              },
              "j2": {
                "type": "number"
              },
              "j3": {
                "type": "number"
              },
              "j4": {
                "type": "number"
              },
              "j5": {
                "type": "number"
              },
              "j6": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "CommandJogStep": {
    "type": "object",
    "description": "Sets this robot's own server-synced jog step size, used by subsequent \"jog\" commands' own client-side amount calculation.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "jogStep"
      },
      "params": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  },
  "CommandReset3D": {
    "type": "object",
    "description": "Signals every OTHER connected client to remount its own local 3D camera view for this robot - no real robot motion or state change.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "reset3D"
      }
    }
  },
  "CommandTool": {
    "type": "object",
    "description": "Sets the robot's currently mounted end-effector/tool label.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "tool"
      },
      "params": {
        "type": "object",
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string"
          }
        }
      }
    }
  },
  "CommandValve": {
    "type": "object",
    "description": "Sets one pneumatic valve's open/closed state.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "valve"
      },
      "params": {
        "type": "object",
        "required": [
          "index",
          "state"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "CommandPump": {
    "type": "object",
    "description": "Sets one vacuum pump's on/off state.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "pump"
      },
      "params": {
        "type": "object",
        "required": [
          "index",
          "state"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "CommandSpeed": {
    "type": "object",
    "description": "Sets playback speed and/or acceleration, each independently optional; at least one is expected to be present for this command to have any effect.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "speed"
      },
      "params": {
        "type": "object",
        "properties": {
          "speed": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          },
          "acceleration": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          }
        }
      }
    }
  },
  "CommandTrajectory": {
    "type": "object",
    "description": "Loads and selects a full point list as this robot's own Work, validated and prepared BEFORE any state is touched (so a racing Play command can never replay a stale trajectory). Unlike every other command, this never applies to a combined sibling - a trajectory belongs to exactly one robot.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "trajectory"
      },
      "params": {
        "type": "object",
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/TrajectoryPoint"
            }
          },
          "selectedWorkFile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"
          },
          "selectedExample": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    }
  },
  "TrajectoryPoint": {
    "type": "object",
    "description": "Every field is optional per point, but the point must carry either all 6 native joints (j1..j6) or a full Cartesian pose (x, y, z) - checked after this shape validates. tx/ty/trz (XY table axes) are only accepted on a robot with a configured XY table.",
    "properties": {
      "j1": {
        "type": "number"
      },
      "j2": {
        "type": "number"
      },
      "j3": {
        "type": "number"
      },
      "j4": {
        "type": "number"
      },
      "j5": {
        "type": "number"
      },
      "j6": {
        "type": "number"
      },
      "x": {
        "type": "number"
      },
      "y": {
        "type": "number"
      },
      "z": {
        "type": "number"
      },
      "a": {
        "type": "number"
      },
      "b": {
        "type": "number"
      },
      "c": {
        "type": "number"
      },
      "tx": {
        "type": "number"
      },
      "ty": {
        "type": "number"
      },
      "trz": {
        "type": "number"
      },
      "motionType": {
        "type": "string",
        "enum": [
          "model-joints"
        ]
      }
    },
    "additionalProperties": false
  },
  "CommandVision": {
    "type": "object",
    "description": "Enables/disables this robot's own vision pipeline, and its assigned camera's connected flag alongside it.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "vision"
      },
      "params": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "RefreshRequest": {
    "type": "object",
    "required": [
      "refreshToken"
    ],
    "properties": {
      "refreshToken": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "RateLimitedResponse": {
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "string"
      },
      "retryAfterMs": {
        "type": "integer",
        "minimum": 0,
        "description": "The length of the rate-limit window."
      }
    },
    "additionalProperties": true
  },
  "SettingsWriteResult": {
    "type": "object",
    "required": [
      "success"
    ],
    "properties": {
      "success": {
        "const": true
      },
      "revision": {
        "type": "string",
        "description": "The revision of the document just written (the value of the next ETag)."
      }
    },
    "additionalProperties": true
  },
  "SettingsConflict": {
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "string"
      },
      "revision": {
        "type": "string",
        "description": "The revision the server holds now."
      }
    },
    "additionalProperties": true
  },
  "ReservationConflict": {
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "string"
      },
      "code": {
        "type": "string",
        "description": "`other-account`, `other-controller` or `controller-id-required`; absent on a server that predates the codes."
      },
      "reservation": {
        "$ref": "#/components/schemas/Reservation"
      }
    },
    "additionalProperties": true
  },
  "ControllerId": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._:-]{1,64}$",
    "description": "Chosen by one control client for its session."
  },
  "Reservation": {
    "type": "object",
    "required": [
      "ownerId",
      "ownerUsername",
      "claimedAt",
      "expiresAt"
    ],
    "properties": {
      "ownerId": {},
      "ownerUsername": {
        "type": "string"
      },
      "claimedAt": {
        "type": "number",
        "description": "Milliseconds since the epoch."
      },
      "expiresAt": {
        "type": "number",
        "description": "Milliseconds since the epoch."
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    },
    "additionalProperties": true
  },
  "ClaimRequest": {
    "type": "object",
    "properties": {
      "ttlMs": {
        "type": "number"
      },
      "force": {
        "type": "boolean",
        "description": "An administrator may take over an active claim."
      },
      "reason": {
        "type": "string",
        "maxLength": 200
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    },
    "additionalProperties": true
  },
  "ReleaseRequest": {
    "type": "object",
    "properties": {
      "reason": {
        "type": "string",
        "maxLength": 200
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    },
    "additionalProperties": true
  },
  "ClaimResponse": {
    "type": "object",
    "required": [
      "success"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "reservation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Reservation"
          },
          {
            "type": "null"
          }
        ]
      },
      "reservationHistory": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "revision": {
        "type": "string",
        "description": "The new revision of the robot (also the `ETag`)."
      }
    },
    "additionalProperties": true
  },
  "JogArmRequest": {
    "type": "object",
    "required": [
      "armed"
    ],
    "properties": {
      "armed": {
        "type": "boolean"
      },
      "ttlMs": {
        "type": "number"
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    },
    "additionalProperties": true
  },
  "JogArmResponse": {
    "type": "object",
    "required": [
      "success",
      "armed"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "armed": {
        "type": "boolean"
      },
      "expiresAt": {
        "type": "number"
      },
      "ttlMs": {
        "type": "number"
      }
    },
    "additionalProperties": true
  },
  "ClaimListEntry": {
    "type": "object",
    "required": [
      "robotId",
      "ownerId",
      "ownerUsername",
      "claimedAt",
      "expiresAt"
    ],
    "properties": {
      "robotId": {
        "type": "integer"
      },
      "robotName": {
        "type": [
          "string",
          "null"
        ]
      },
      "cellId": {},
      "ownerId": {},
      "ownerUsername": {
        "type": "string"
      },
      "controllerId": {
        "type": [
          "string",
          "null"
        ],
        "description": "The controller that holds the claim, null for a claim made without one. This is not the cell id of the settings tree."
      },
      "claimedAt": {
        "type": "number"
      },
      "expiresAt": {
        "type": "number"
      },
      "jogArmedUntil": {
        "type": [
          "number",
          "null"
        ],
        "description": "When the arming of the jog of this robot ends, null when it is not armed."
      }
    },
    "additionalProperties": true
  },
  "ClaimList": {
    "type": "object",
    "required": [
      "claims"
    ],
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ClaimListEntry"
        }
      }
    },
    "additionalProperties": true
  },
  "SafetyLimitsView": {
    "type": "object",
    "required": [
      "limits",
      "defaults",
      "hardLimits"
    ],
    "properties": {
      "limits": {
        "type": "object",
        "additionalProperties": true,
        "description": "The limits in force: `jog` (armRequired, armTtlMs, default, models), `temperature` (default, models) and `claims` (requireControllerId)."
      },
      "defaults": {
        "type": "object",
        "additionalProperties": true
      },
      "hardLimits": {
        "type": "object",
        "additionalProperties": true,
        "description": "Ceilings that no setting can pass."
      },
      "robot": {
        "type": "object",
        "description": "Present with `robotId`: the limits that apply to that robot model and, when its jog is armed, `jogArmedUntil`.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "jog": {
            "type": "object",
            "additionalProperties": true
          },
          "temperature": {
            "type": "object",
            "additionalProperties": true
          },
          "jogArmedUntil": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "SafetyLimitsUpdateResult": {
    "allOf": [
      {
        "$ref": "#/components/schemas/SafetyLimitsView"
      },
      {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      }
    ]
  },
  "SafetyLimitsPatch": {
    "type": "object",
    "description": "A partial change, validated by the server. An object under `models` replaces the whole table of that section; models are keyed by name without the parenthesis and without case.",
    "properties": {
      "jog": {
        "type": "object",
        "additionalProperties": true
      },
      "temperature": {
        "type": "object",
        "additionalProperties": true
      },
      "claims": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "RevisionConflict": {
    "type": "object",
    "required": [
      "error",
      "code",
      "revision"
    ],
    "properties": {
      "error": {
        "type": "string"
      },
      "code": {
        "const": "revision-mismatch"
      },
      "revision": {
        "type": "string",
        "description": "The current revision of the robot."
      }
    },
    "additionalProperties": true
  },
  "RobotView": {
    "type": "object",
    "required": [
      "robot",
      "revision"
    ],
    "properties": {
      "robot": {
        "type": "object",
        "additionalProperties": true,
        "description": "The robot as the server holds it; the credentials of the cameras are left out unless the caller is an administrator."
      },
      "revision": {
        "type": "string",
        "description": "Fingerprint of the robot, also the `ETag` of the answer. The record of past claims, the times of a claim and the step counter of a running playback are not part of it."
      },
      "cellId": {
        "description": "The cell (controller of the settings tree) the robot belongs to."
      }
    },
    "additionalProperties": true
  },
  "CommandTable": {
    "type": "object",
    "description": "One move of the XY table of a robot in one request. It is checked as a whole before anything changes (finite numbers; a relative move within the largest jog of the model, an absolute one and the position a move ends in within the largest absolute position) and needs the claim like every command but `stop`, and the arming while it is demanded. The robot must have a configured XY table. It touches the robot it is sent to, never its combined siblings.",
    "required": [
      "command",
      "params"
    ],
    "properties": {
      "command": {
        "const": "table"
      },
      "params": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rz": {
            "type": "number"
          },
          "mode": {
            "type": "string",
            "enum": [
              "absolute",
              "relative"
            ],
            "default": "absolute"
          }
        },
        "additionalProperties": false
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    }
  },
  "AuditEntry": {
    "type": "object",
    "required": [
      "seq",
      "ts",
      "type",
      "outcome",
      "prev",
      "hash"
    ],
    "properties": {
      "seq": {
        "type": "integer"
      },
      "ts": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "description": "`claim`, `force-claim`, `release`, `force-release`, `jog-arm`, `safety-limits` or `stop-all`."
      },
      "outcome": {
        "type": "string",
        "enum": [
          "ok",
          "refused",
          "failed"
        ]
      },
      "username": {
        "type": "string"
      },
      "controllerId": {
        "type": "string"
      },
      "ip": {
        "type": "string"
      },
      "robotId": {
        "type": "integer"
      },
      "detail": {
        "type": "object",
        "additionalProperties": true
      },
      "prev": {
        "type": "string",
        "description": "SHA-256 of the previous line (64 zeros for the first)."
      },
      "hash": {
        "type": "string",
        "description": "SHA-256 of this line without this field."
      }
    },
    "additionalProperties": true
  },
  "AuditView": {
    "type": "object",
    "required": [
      "enabled",
      "entries"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "lockedOff": {
        "type": "boolean",
        "description": "True when the environment of the deployment switched the record off."
      },
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AuditEntry"
        }
      },
      "verification": {
        "type": "object",
        "additionalProperties": true,
        "description": "Only with `verify=1`: whether the hash chain of every file is intact."
      }
    },
    "additionalProperties": true
  },
  "ClaimsEvent": {
    "type": "object",
    "description": "WebSocket message pushed to the clients that opened `/ws` with `?remoteApiVersion=2` after a claim, a release, an arming or a stop changed. A claim that merely expires is not announced.",
    "required": [
      "type",
      "claims"
    ],
    "properties": {
      "type": {
        "const": "claims"
      },
      "schema": {
        "const": 2
      },
      "claims": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ClaimListEntry"
        }
      }
    }
  },
  "CommandDisable": {
    "type": "object",
    "description": "Puts one robot in safe mode: it stops, its valves and pumps go off, the arming of its jog is dropped and it is marked `enabled: false`. Every other command of the robot except `stop` and `enable` is then refused with `423` (`robot-disabled`). Like `stop` it is open to every signed-in account and is never blocked by a claim or a stale revision. It touches only the robot it is sent to.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "disable"
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    }
  },
  "CommandEnable": {
    "type": "object",
    "description": "Brings a robot in safe mode back and restarts nothing (it stays stopped; the jog has to be armed again). It is off by default: `403` with `enable-not-allowed` until an administrator turns on `robots.allowEnable` on the server, and then only an administrator may use it (`403` with `admin-required`). The claim check applies as for any command but `stop`. It touches only the robot it is sent to.",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "const": "enable"
      },
      "controllerId": {
        "$ref": "#/components/schemas/ControllerId"
      }
    }
  },
  "EcosystemHealth": {
    "title": "EcosystemHealth",
    "description": "The read-only health of the services of the ecosystem that a server answers at GET /api/ecosystem/health: for each service that declares a port or a unit, whether it answers, the version it reports against the one its manifest expects, and the state of the TLS certificate of the server itself. The port, health path, unit and active state of a service are only in the answer to an administrator.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "generated_at_utc",
      "available",
      "summary",
      "services",
      "certificate",
      "warnings"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "generated_at_utc": {
        "type": "string",
        "format": "date-time"
      },
      "available": {
        "type": "boolean",
        "description": "False when the sibling checkouts could not be scanned at all (then there are no services)."
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "ok",
          "degraded",
          "down",
          "unknown",
          "drift"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "ok": {
            "type": "integer",
            "minimum": 0
          },
          "degraded": {
            "type": "integer",
            "minimum": 0
          },
          "down": {
            "type": "integer",
            "minimum": 0
          },
          "unknown": {
            "type": "integer",
            "minimum": 0
          },
          "drift": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "services": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "family",
            "role",
            "state",
            "reason",
            "version_expected",
            "version_reported",
            "drift",
            "last_seen_utc",
            "latency_ms"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "family": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "enum": [
                "ok",
                "degraded",
                "down",
                "unknown"
              ]
            },
            "reason": {
              "enum": [
                "health_ok",
                "health_degraded",
                "health_failed",
                "http_error",
                "unreachable",
                "unreachable_unit_active",
                "reachable_unit_not_active",
                "unit_active",
                "unit_starting",
                "unit_failed",
                "unit_inactive",
                "no_signal",
                "probe_error"
              ]
            },
            "version_expected": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,23}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_reported": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,23}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "drift": {
              "type": "boolean",
              "description": "True only when both versions are known and differ."
            },
            "last_seen_utc": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "port": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ],
              "description": "Administrators only."
            },
            "health_path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Administrators only."
            },
            "systemd_unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Administrators only."
            },
            "active_state": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Administrators only."
            }
          }
        }
      },
      "certificate": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "not_after_utc",
              "days_left",
              "warn_days"
            ],
            "description": "The TLS certificate of the server itself; null when it runs without TLS. The path and the key are never part of it.",
            "properties": {
              "state": {
                "enum": [
                  "ok",
                  "expiring",
                  "expired",
                  "unreadable"
                ]
              },
              "not_after_utc": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "days_left": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "warn_days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "certificate_expiring",
                "certificate_expired",
                "certificate_unreadable",
                "version_drift",
                "service_down",
                "service_degraded"
              ]
            },
            "service": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      }
    }
  },
  "RobotLiveness": {
    "title": "RobotLiveness",
    "description": "The signal of life of each robot of the roster that a server answers at GET /api/robots/liveness: live when the server had news of the robot within stale_after_s, stale when the last news is older and unknown when there has been none since the server started. It is news the server received, not a measurement of the hardware, and it is not the online flag of the settings.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "stale_after_s",
      "robots"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "stale_after_s": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      },
      "robots": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controller_id",
            "robot_id",
            "state"
          ],
          "properties": {
            "controller_id": {
              "type": "string",
              "maxLength": 100
            },
            "robot_id": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "enum": [
                "live",
                "stale",
                "unknown"
              ]
            },
            "last_update_utc": {
              "type": "string",
              "format": "date-time",
              "description": "Absent while the state is unknown."
            },
            "age_s": {
              "type": "integer",
              "minimum": 0,
              "description": "Absent while the state is unknown."
            },
            "source": {
              "enum": [
                "state",
                "heartbeat"
              ],
              "description": "Absent while the state is unknown."
            }
          }
        }
      }
    }
  },
  "GlobalStopReleased": {
    "type": "object",
    "required": [
      "success",
      "announced"
    ],
    "properties": {
      "success": {
        "const": true
      },
      "announced": {
        "type": "boolean",
        "description": "Whether the retained READY went out on the MQTT bridge. False when announcing the global stop is not configured or the broker is not connected."
      }
    },
    "additionalProperties": true
  },
  "RulConfig": {
    "title": "RulConfig",
    "description": "What a signed-in client may read of the remaining-useful-life relay at GET /api/rul/config: whether an operator may use it and the two limits that size a request. Nothing else is part of it.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "enabled",
      "maxPoints",
      "timeoutMs"
    ],
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "True only when the relay is open to operators; false by default and whenever the configuration cannot be read."
      },
      "maxPoints": {
        "type": "integer",
        "minimum": 8,
        "maximum": 100000,
        "description": "Largest number of points the relay accepts in one request (5000 by default)."
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 500,
        "maximum": 60000,
        "description": "How long the relay waits for the detector, in milliseconds (8000 by default)."
      }
    }
  }
}
