{
  "source_version": "1",
  "group": "login",
  "kind": "inventory",
  "routes": [
    {
      "method": "post",
      "path": "/api/login",
      "summary": "POST /api/login",
      "description": "No authentication required by the route itself.",
      "access": "public",
      "rate_limited": true,
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "username",
                "password"
              ],
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "totp": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success. The body is documented in docs/REMOTE_API.md.",
          "shape": "LoginResult"
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "401": {
          "description": "Not signed in or token rejected. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "429": {
          "description": "Rate limited. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    }
  ]
}
