{
  "source_version": "1",
  "group": "robot",
  "kind": "inventory",
  "routes": [
    {
      "method": "get",
      "path": "/api/robot/{id}",
      "summary": "GET /api/robot/{id}",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The robot (cameras' credentials only for an administrator), its revision and the controller that holds it. The ETag header is the revision. Answers 200.",
          "schema": {
            "type": "object",
            "properties": {
              "robot": {
                "type": "object"
              },
              "revision": {
                "type": "string"
              },
              "cellId": {
                "description": "The id of the controller the robot belongs to (null when it is in none)."
              }
            },
            "required": [
              "robot",
              "revision"
            ]
          },
          "headers": {
            "ETag": {
              "description": "The revision of the document, to send back as If-Match.",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/robot/{id}/claim",
      "summary": "POST /api/robot/{id}/claim",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "If-Match",
          "in": "header",
          "required": false,
          "description": "The revision read from GET /api/robot/{id}; the request is refused (412, revision-mismatch) when the robot is no longer that version.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "X-Controller-Id",
          "in": "header",
          "required": false,
          "description": "The controller (one client of the account) that asks, 1 to 64 characters: letters, digits, . _ : - (the body field controllerId says the same).",
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [],
              "properties": {
                "ttlMs": {
                  "type": "number"
                },
                "force": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                },
                "controllerId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The claim is held (renewed or taken); the ETag header is the new revision of the robot. Answers 200.",
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "reservation": {
                "type": "object"
              },
              "reservationHistory": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "success",
              "reservation",
              "reservationHistory",
              "revision"
            ]
          },
          "headers": {
            "ETag": {
              "description": "The revision of the document, to send back as If-Match.",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "412": {
          "description": "The robot changed since it was read (If-Match). The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/robot/{id}/command",
      "summary": "POST /api/robot/{id}/command",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "If-Match",
          "in": "header",
          "required": false,
          "description": "The revision read from GET /api/robot/{id}; the command is refused (412, revision-mismatch) when the robot is no longer that version. Not applied to stop or disable.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "X-Controller-Id",
          "in": "header",
          "required": false,
          "description": "The controller (one client of the account) that asks, 1 to 64 characters: letters, digits, . _ : - (the body field controllerId says the same).",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "description": "A correlation id carried to the operation and its lifecycle events.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "description": "One of the commands the server knows (an unknown one answers 400)."
                },
                "params": {
                  "type": "object"
                },
                "seq": {
                  "type": "integer"
                },
                "controllerId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The command was accepted and applied; the answer says so with the operation and its first lifecycle event. Answers 200.",
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "affectedCount": {
                "type": "number"
              },
              "revision": {
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              },
              "operation": {
                "type": "object"
              },
              "lifecycle": {
                "type": "object"
              },
              "applied": {
                "type": "object"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "description": "A string or an object with a message (and the field it is about)."
                }
              }
            },
            "required": [
              "success",
              "revision"
            ]
          }
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "403": {
          "description": "Signed in but not allowed. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "412": {
          "description": "The robot changed since it was read (If-Match). The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "423": {
          "description": "Response. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/robot/{id}/heartbeat",
      "summary": "POST /api/robot/{id}/heartbeat",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success. The body is documented in docs/REMOTE_API.md.",
          "shape": "Success"
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/robot/{id}/jog-arm",
      "summary": "POST /api/robot/{id}/jog-arm",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "X-Controller-Id",
          "in": "header",
          "required": false,
          "description": "The controller (one client of the account) that asks, 1 to 64 characters: letters, digits, . _ : - (the body field controllerId says the same).",
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "armed": {
                  "type": "boolean"
                },
                "ttlMs": {
                  "type": "number"
                },
                "controllerId": {
                  "type": "string"
                }
              },
              "required": [
                "armed"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The jog is armed or disarmed; when armed, until expiresAt for ttlMs. Answers 200.",
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "armed": {
                "type": "boolean"
              },
              "expiresAt": {
                "type": "number"
              },
              "ttlMs": {
                "type": "number"
              }
            },
            "required": [
              "success",
              "armed"
            ]
          }
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "423": {
          "description": "Response. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    },
    {
      "method": "post",
      "path": "/api/robot/{id}/release",
      "summary": "POST /api/robot/{id}/release",
      "description": "Requires a signed-in account (bearer token).",
      "access": "user",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "If-Match",
          "in": "header",
          "required": false,
          "description": "The revision read from GET /api/robot/{id}; the request is refused (412, revision-mismatch) when the robot is no longer that version.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "X-Controller-Id",
          "in": "header",
          "required": false,
          "description": "The controller (one client of the account) that asks, 1 to 64 characters: letters, digits, . _ : - (the body field controllerId says the same).",
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [],
              "properties": {
                "reason": {
                  "type": "string"
                },
                "controllerId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The claim is released (releasing a robot nobody holds is a success too); the ETag header is the new revision of the robot. Answers 200.",
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "reservationHistory": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "success",
              "reservationHistory",
              "revision"
            ]
          },
          "headers": {
            "ETag": {
              "description": "The revision of the document, to send back as If-Match.",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "400": {
          "description": "Invalid request. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "404": {
          "description": "Not found. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "409": {
          "description": "Conflict with the current state. The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        },
        "412": {
          "description": "The robot changed since it was read (If-Match). The body is documented in docs/REMOTE_API.md.",
          "shape": "Error"
        }
      }
    }
  ]
}
