{
  "name": "@hydra-umc/sdk",
  "version": "0.1.0",
  "description": "TypeScript reference client for HYDRA-UMC-SDK: hand-written types plus real Ajv-based runtime validation for the v1 JSON Schema contracts.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
