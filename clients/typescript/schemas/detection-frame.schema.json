{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanenrac.github.io/HYDRA-UMC-SDK/contracts/json-schema/v1/detection-frame.schema.json",
  "title": "DetectionFrame",
  "description": "The second stage of the vision pipeline: the detections a model found in one frame, tied to it by frame_id and capture_ts_utc. The convention of the boxes is part of the data: box_unit is pixel or normalized (0 to 1), the origin is the top left corner of the frame (x to the right, y downwards) and a box is given by its corners x_min, y_min, x_max, y_max. The clients also check that x_min is not greater than x_max and y_min not greater than y_max, which a schema cannot say. model is the compatibility record of the model that produced the detections. The schema is closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "capture_ts_utc",
    "box_unit",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "The frame the detections belong to."
    },
    "capture_ts_utc": {
      "type": "string",
      "format": "date-time",
      "description": "When that frame was captured."
    },
    "box_unit": {
      "enum": [
        "pixel",
        "normalized"
      ],
      "description": "The unit of every box of this message."
    },
    "detections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "label",
          "score",
          "box"
        ],
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x_min",
              "y_min",
              "x_max",
              "y_max"
            ],
            "properties": {
              "x_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "y_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "x_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "y_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              }
            }
          }
        }
      }
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "The capture session of the frame."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "model_version",
        "model_sha256",
        "hailo_arch",
        "pipeline_version"
      ],
      "properties": {
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hailo_arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "box_unit": {
            "const": "normalized"
          }
        },
        "required": [
          "box_unit"
        ]
      },
      "then": {
        "properties": {
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "box": {
                  "type": "object",
                  "properties": {
                    "x_min": {
                      "type": "number",
                      "maximum": 1
                    },
                    "y_min": {
                      "type": "number",
                      "maximum": 1
                    },
                    "x_max": {
                      "type": "number",
                      "maximum": 1
                    },
                    "y_max": {
                      "type": "number",
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
