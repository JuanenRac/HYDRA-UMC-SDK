{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanenrac.github.io/HYDRA-UMC-SDK/contracts/json-schema/v1/node-snapshot.schema.json",
  "title": "NodeSnapshot",
  "description": "What the edge side of the maintenance agent reports about one node in one pass: the projects found, the manifests that did not parse, the units and health routes it asked, the incidents it derived and, when the host checks are on, what the machine says about itself. The wire form is the one the agent writes, with camelCase names, and the schema is closed. schema_version is optional so that a snapshot written before the contract existed still validates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceNode",
    "collectedAt",
    "correlationId",
    "projects",
    "manifestIssues",
    "systemdAvailable",
    "systemdUnavailableReason",
    "serviceHealth",
    "httpHealth",
    "incidents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sourceNode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "The node the snapshot is about."
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the pass ran."
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "Shared by the incidents of this pass."
    },
    "projects": {
      "type": "array",
      "maxItems": 1000,
      "description": "The projects whose manifest was read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "maturity",
          "manifestPath"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Name from the manifest."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Version from the manifest."
          },
          "maturity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Maturity from the manifest."
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Where the manifest is."
          }
        }
      }
    },
    "manifestIssues": {
      "type": "array",
      "maxItems": 1000,
      "description": "Manifests that could not be used.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "The folder or file."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Why it could not be used (redacted)."
          }
        }
      }
    },
    "systemdAvailable": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "null: systemd was never asked; true or false: it was asked and answered or did not."
    },
    "systemdUnavailableReason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000,
      "description": "Why systemd could not be asked."
    },
    "serviceHealth": {
      "type": "array",
      "maxItems": 1000,
      "description": "The units that were asked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitName",
          "active",
          "detail"
        ],
        "properties": {
          "unitName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "The unit."
          },
          "active": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 2000,
            "description": "What systemctl said (redacted)."
          }
        }
      }
    },
    "httpHealth": {
      "type": "array",
      "maxItems": 1000,
      "description": "The health routes that were asked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "reachable",
          "statusCode",
          "detail"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "The route (redacted)."
          },
          "reachable": {
            "type": "boolean"
          },
          "statusCode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "maxLength": 2000,
            "description": "What came back (redacted)."
          }
        }
      }
    },
    "incidents": {
      "type": "array",
      "maxItems": 10000,
      "description": "The incidents of this pass, each one a MaintenanceIncident.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidentId",
          "sourceNode",
          "detectedAt",
          "severity",
          "component",
          "symptom",
          "evidenceRefs",
          "redactionLevel",
          "requestedBy",
          "correlationId"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "incidentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$",
            "description": "The incident."
          },
          "sourceNode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$",
            "description": "The node the agent observed."
          },
          "detectedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the agent saw it."
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "description": "What was observed."
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The service, unit or file concerned."
          },
          "symptom": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What was observed, in words."
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "One reference."
            },
            "description": "Where the evidence can be found."
          },
          "redactionLevel": {
            "enum": [
              "sanitized",
              "raw"
            ],
            "description": "sanitized when the text fields are redacted."
          },
          "requestedBy": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120,
            "description": "Who asked for the observation, or null."
          },
          "correlationId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$",
            "description": "Shared by the incidents of one collection pass."
          }
        }
      }
    },
    "hostHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disks",
        "thermal",
        "backups"
      ],
      "description": "What the machine says about itself; present only when the host checks are on.",
      "properties": {
        "disks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "freeBytes",
              "totalBytes",
              "freePercent",
              "error"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "The folder measured."
              },
              "freeBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Free bytes."
              },
              "totalBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Total bytes."
              },
              "freePercent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "Free space in percent."
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200,
                "description": "Why it could not be read."
              }
            }
          }
        },
        "thermal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "celsius",
            "throttledRaw",
            "throttledNow",
            "throttledPast",
            "vcgencmdAvailable"
          ],
          "properties": {
            "celsius": {
              "type": [
                "number",
                "null"
              ],
              "description": "Temperature of the board, null when it cannot be read."
            },
            "throttledRaw": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "The value of vcgencmd get_throttled."
            },
            "throttledNow": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "A flag that is active now."
              }
            },
            "throttledPast": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "A flag that was active since boot."
              }
            },
            "vcgencmdAvailable": {
              "type": "boolean"
            }
          }
        },
        "backups": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "directory",
            "count",
            "newestAgeDays",
            "error"
          ],
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "The backup folder."
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Backups found."
            },
            "newestAgeDays": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Age of the newest backup in days."
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200,
              "description": "Why it could not be read."
            }
          }
        }
      }
    }
  }
}
