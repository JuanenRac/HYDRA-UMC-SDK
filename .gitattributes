# Auto detect text files and perform LF normalization
* text=auto
# The schemas are hashed byte for byte (manifest.json), so they keep LF on every platform.
*.json text eol=lf

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Two pull requests that add an entry to the CHANGELOG at the same place do not conflict: git keeps both entries when it merges or rebases.
CHANGELOG.md merge=union
CHANGELOG_*.md merge=union
CHANGELOG.*.md merge=union
